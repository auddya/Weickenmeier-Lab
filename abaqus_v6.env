import os
scratch='/data/engs-brain-health/engs3052/abaqus_scratch_files'
mp_file_system=(SHARED, SHARED)
mp_host_list=[['arc-c294', 48],['arc-c295', 48]]
mp_mpi_implementation = IMPI
mp_mpirun_path = {IMPI:'/apps/system/easybuild/software/impi/2019.7.217-iccifort-2020.1.217/intel64/bin/mpiexec.hydra'}
fortCmd = "ifort"
compile_fortran = (fortCmd + 
                    " -c" +
    " -fpic" +
                    " -extend-source" +
                    " -recursive" +
                    " -qmkl" +
                    " -pc64" +
                    " -prec-div -prec-sqrt" +
                    " -no-fma" +
                    " -fp-model=precise " +
                    " -fimf-arch-consistency=true" +
                    " -fp-speculation=safe" +
                    " -fprotect-parens" +
                    " -fp-stack-check" +
                    " -reentrancy threaded" +
                    " -init=snan -init=arrays" +
                    " -xSSE3 -axAVX" +
                    " -auto-scalar" +
                    " -I%I" +
                    " -fixed" +
                    " -O3" +
                    " -fpp" +
                    " -qopenmp" +
                    " -ftz" +
                    " -diag-disable:5268" +
                    " -standard-semantics " +   
                    " -nostandard-realloc-lhs" +
                    " -real-size 64"
)
# Abaqus/CAE will generate an input file without parts and assemblies.
cae_no_parts_input_file=ON
# Both the Abaqus/Explicit packager and analysis are run in double precision.
double_precision=BOTH
# The user will not be asked whether old job files of the same name should be deleted.
ask_delete=OFF

# usub_lib_dir='your_prefered_location/abqlib'

# Remove the temporary names from the namespace
del fortCmd
